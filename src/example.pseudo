DECLARE Total : INTEGER
DECLARE Number : INTEGER 
Total <- 0
OUTPUT "how many numbers"
INPUT Number

FOR Counter <- 1 TO Number
	DECLARE X : INTEGER
	OUTPUT "Enter Value"
	INPUT X
	Total <- Total + X
NEXT Counter

DECLARE Average : REAL 
Average <- Total / Number
OUTPUT Average
